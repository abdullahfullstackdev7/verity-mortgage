ENV=local

# Points at the docker-compose `postgres` service (see docker-compose.yml).
DATABASE_URL=postgresql+psycopg://verity:verity_dev_password@localhost:5434/verity_mortgage

# Generate a real secret for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=20
REFRESH_TOKEN_EXPIRE_DAYS=14

CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:3000"]

DOCUMENT_STORAGE_DIR=data/documents/uploaded
MAX_UPLOAD_SIZE_BYTES=10485760

# LLM extraction/summary fallback (both free tier). Leave unset to disable
# the LLM fallback path entirely — the pipeline works fine without it, just
# with more unresolved low-confidence fields.
GROQ_API_KEY=
GEMINI_API_KEY=
